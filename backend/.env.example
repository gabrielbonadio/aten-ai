# =============================================================================
# Aten AI — Backend (.env.example)
# Copie para .env e preencha com valores reais: cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Servidor
# -----------------------------------------------------------------------------
# Porta HTTP da API
PORT=3000

# Ambiente Node (development | production | test)
NODE_ENV=development

# Nível de log estruturado: debug | info | warn | error
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Banco de dados (MySQL 8)
# -----------------------------------------------------------------------------
# Host do MySQL (em Docker Compose use o nome do serviço: mysql)
DB_HOST=localhost

# Porta do MySQL
DB_PORT=3306

# Usuário do banco
DB_USER=aten_ai

# Senha do banco
DB_PASS=change-me

# Nome do banco
DB_NAME=aten_ai_db

# -----------------------------------------------------------------------------
# Autenticação (JWT)
# -----------------------------------------------------------------------------
# Segredo para assinar tokens (mínimo 16 caracteres)
JWT_SECRET=change-me-use-a-long-random-string

# Tempo de expiração do access token (ex.: 7d, 12h, 60m)
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# E-mail (Resend)
# -----------------------------------------------------------------------------
# Chave da API Resend (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Remetente dos e-mails transacionais
EMAIL_FROM=noreply@yourdomain.com

# -----------------------------------------------------------------------------
# Frontend (links em e-mails)
# -----------------------------------------------------------------------------
# URL pública do portal Angular (reset de senha, boas-vindas, etc.)
FRONTEND_URL=http://localhost:4200

# -----------------------------------------------------------------------------
# Webhooks — n8n (agendamentos / lembretes / follow-up)
# -----------------------------------------------------------------------------
# URL do webhook n8n que recebe eventos outbound da API
N8N_WEBHOOK_URL=http://localhost:5678/webhook/your-webhook-id

# Shared secret para autenticar chamadas bidirecionais (outbound + inbound)
# Outbound: header Authorization: Bearer <secret>
# Inbound:  POST /api/v1/conversations/reply com o mesmo header
N8N_WEBHOOK_SECRET=change-me

# -----------------------------------------------------------------------------
# Webhooks — n8n (prontuários médicos)
# -----------------------------------------------------------------------------
# URL dedicada para eventos de prontuário criado
N8N_MEDICAL_RECORD_WEBHOOK_URL=http://localhost:5678/webhook/medical-record

# Chave opcional enviada no header x-api-key
N8N_MEDICAL_RECORD_WEBHOOK_API_KEY=change-me
