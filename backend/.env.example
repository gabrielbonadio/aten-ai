# =============================================================================
# Aten AI — Backend (.env.example)
# Copie para .env e preencha com valores reais: cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Servidor
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# Jobs no mesmo processo da API (false = use `npm run worker` em processo separado)
ENABLE_IN_PROCESS_JOBS=true

# -----------------------------------------------------------------------------
# Banco de dados (MySQL 8)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=aten_ai
DB_PASS=change-me-strong-db-password
DB_NAME=aten_ai_db

# Pool Sequelize (ajuste conforme réplicas × carga)
DB_POOL_MAX=5
DB_POOL_MIN=0
DB_POOL_ACQUIRE_MS=30000
DB_POOL_IDLE_MS=10000

# -----------------------------------------------------------------------------
# Autenticação (JWT)
# -----------------------------------------------------------------------------
# Segredo para assinar tokens (mínimo 32 caracteres; nunca use placeholders em produção)
JWT_SECRET=dev-only-change-me-to-a-long-random-string

# Access token curto (refresh token cobre a sessão longa via /auth/refresh)
JWT_EXPIRES_IN=1h

# -----------------------------------------------------------------------------
# E-mail (Resend)
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@yourdomain.com

# -----------------------------------------------------------------------------
# Frontend (CORS + links em e-mails) — obrigatório em production
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:4200

# -----------------------------------------------------------------------------
# Webhooks — n8n (agendamentos / lembretes / follow-up)
# -----------------------------------------------------------------------------
N8N_WEBHOOK_URL=http://localhost:5678/webhook/your-webhook-id
N8N_WEBHOOK_SECRET=dev-only-change-me-webhook-secret

# -----------------------------------------------------------------------------
# Webhooks — n8n (prontuários médicos)
# -----------------------------------------------------------------------------
N8N_MEDICAL_RECORD_WEBHOOK_URL=http://localhost:5678/webhook/medical-record
N8N_MEDICAL_RECORD_WEBHOOK_API_KEY=dev-only-change-me-api-key

# -----------------------------------------------------------------------------
# LGPD — criptografia de campos clínicos (sintomas/diagnóstico/prescrição)
# -----------------------------------------------------------------------------
# Opcional em development; recomendado em production.
# Gere com: openssl rand -hex 32
# PII_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Observabilidade (Sentry — opcional)
# -----------------------------------------------------------------------------
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
