# =============================================================================
# Aten AI — Docker Compose (.env.example)
# Copie para .env na raiz do monorepo: cp .env.example .env
# =============================================================================

# Portas expostas no host
BACKEND_HOST_PORT=3000
FRONTEND_HOST_PORT=8080
MYSQL_HOST_PORT=3306

# URL pública da API (acessível pelo navegador — usada no build do frontend)
API_URL=http://localhost:3000

# URL pública do portal (links em e-mails do backend)
FRONTEND_URL=http://localhost:8080

# MySQL
MYSQL_ROOT_PASSWORD=root
DB_NAME=aten_ai_db
DB_USER=aten_ai
DB_PASS=aten_ai_pass

# JWT (obrigatório trocar em produção)
JWT_SECRET=change-me-use-a-long-random-string
JWT_EXPIRES_IN=7d

# E-mail (opcional em dev)
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com

# n8n (opcional em dev)
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=change-me
N8N_MEDICAL_RECORD_WEBHOOK_URL=
N8N_MEDICAL_RECORD_WEBHOOK_API_KEY=
