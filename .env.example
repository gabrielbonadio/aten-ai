# =============================================================================
# Aten AI — Docker Compose (.env.example)
# Copie para .env na raiz do monorepo: cp .env.example .env
# Em production NÃO use os valores de exemplo abaixo.
# =============================================================================

BACKEND_HOST_PORT=3000
FRONTEND_HOST_PORT=8080

API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:8080

MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
DB_NAME=aten_ai_db
DB_USER=aten_ai
DB_PASS=replace-with-strong-db-password
DB_POOL_MAX=10

# Gere com: openssl rand -hex 32
JWT_SECRET=replace-with-openssl-rand-hex-32-output-here
JWT_EXPIRES_IN=1h
ENABLE_IN_PROCESS_JOBS=true

RESEND_API_KEY=
EMAIL_FROM=noreply@example.com

N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=replace-with-strong-webhook-secret
N8N_MEDICAL_RECORD_WEBHOOK_URL=
N8N_MEDICAL_RECORD_WEBHOOK_API_KEY=
